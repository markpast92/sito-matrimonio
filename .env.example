# -------------------------------------------------------
# Copia questo file in .env e riempi i valori.
# NON committare .env su GitHub.
# -------------------------------------------------------

# Password per gli ospiti (inviata separatamente dal QR)
SITE_PASSWORD=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TUOPROGETTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM=noreply@resend.dev

# Dati bancari per l'email regalo
WEDDING_IBAN=
WEDDING_INTESTATARIO=
WEDDING_CAUSALE_PREFIX=Regalo matrimonio [nome sposi]

# Credenziali dashboard admin
ADMIN_USER_1=nome sposo/a
ADMIN_EMAIL_1=
ADMIN_USER_2=nome sposo/a
ADMIN_EMAIL_2=
ADMIN_PASSWORD=
